# Nexus Engine Environment Configuration
# Copy to .env and configure as needed.

# Application Environment (development | production)
ENVIRONMENT=development
DEMO_MODE=true
HOST=127.0.0.1
PORT=8000

# SQLite Storage Configuration
DATABASE_URL=sqlite:///./nexus_engine.db

# Authentication / Keycloak OIDC Settings
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/nexus-realm
OIDC_CLIENT_ID=nexus-engine-client
OIDC_AUDIENCE=nexus-engine-api
OIDC_ENABLED=false

# LLM Provider Configuration (Optional - Offline core works without LLM key)
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=

# Execution Sandbox Limits
MAX_EXECUTION_TIMEOUT_SECONDS=120
MAX_CHUNK_SIZE_BYTES=65536
OUTPUT_SANDBOX_THRESHOLD_BYTES=512
